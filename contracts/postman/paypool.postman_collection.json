{
  "info": {
    "name": "PayPool — disposable simulator walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the entire collection in order against a fresh local demo database. This creates three requests and simulates authorization/delivery/capture. It is not a real PayPal test. No secrets are included; browser-independent login cookies are handled by the collection runner."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8200"
    },
    {
      "key": "verified_demo",
      "value": "no"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const local = /^http:\\/\\/(127\\.0\\.0\\.1|localhost)(:\\d+)?$/.test(pm.variables.get(\"base_url\") || \"\");",
          "if (!local || (pm.info.requestName !== \"Verify simulator\" && pm.collectionVariables.get(\"verified_demo\") !== \"yes\")) { pm.execution.skipRequest(); throw new Error(\"Run the full collection against a disposable local simulator only.\"); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Verify simulator",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/config"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const data = pm.response.json();",
              "\npm.collectionVariables.set(\"verified_demo\", \"no\");\npm.test(\"Only a labelled local simulator is allowed\", () => {\n  pm.expect(data.demo_mode).to.eql(true);\n  pm.expect(data.payment_provider).to.eql(\"demo\");\n});\nif (!data.demo_mode || data.payment_provider !== \"demo\") {\n  pm.execution.setNextRequest(null);\n} else {\n  pm.collectionVariables.set(\"verified_demo\", \"yes\");\n  pm.collectionVariables.set(\"demo_password\", data.demo_password);\n  pm.collectionVariables.set(\"dispatch_date\", new Date(Date.now()+2*86400000).toISOString().slice(0,10));\n}\n",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in: ananya",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"ananya@paypool.demo\", \"password\": \"{{demo_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"csrf\", data.csrf);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Search eligible catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/catalog/search?brand=Harvest&unit=kg"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const data = pm.response.json();",
              "pm.test(\"Serviceable stock exists\", () => pm.expect(data.total).to.be.above(0));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Interpret a buying request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
