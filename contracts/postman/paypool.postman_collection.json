        "url": "{{base_url}}/api/v1/procurement/discover",
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"30 kg Sona Masoori rice by {{dispatch_date}}, landed price below USD 1.70/kg\", \"currency\": \"USD\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
