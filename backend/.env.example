# Never commit a real API key. Export these values in your shell or secret store.
GEMINI_API_KEY=
PAYPOOL_GEMINI_MODEL=gemini-3.8-flash
PAYPOOL_LLM_TIMEOUT_MS=20000
# Retries only transient 5xx/network failures. Total attempts = retries + 1.
PAYPOOL_LLM_MAX_RETRIES=2
PAYPOOL_LLM_RETRY_BACKOFF_MS=500
# Set to deterministic only for offline development and tests.
PAYPOOL_LLM_PROVIDER=gemini
