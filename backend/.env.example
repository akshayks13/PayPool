# Local demonstration. Never commit real credentials.
PAYPOOL_DEMO_MODE=true
DATABASE_URL=sqlite:///./data/paypool.db
PAYPOOL_POSTGIS=false
PAYPOOL_FRONTEND_URL=http://localhost:3000
PAYPOOL_COOKIE_SECURE=false
PAYPOOL_ENABLE_LEGACY_API=false

# deterministic is explicitly offline; gemini requires a real key/model.
PAYPOOL_LLM_PROVIDER=deterministic
GEMINI_API_KEY=
PAYPOOL_GEMINI_MODEL=gemini-2.5-flash
PAYPOOL_LLM_TIMEOUT_MS=20000
PAYPOOL_LLM_MAX_RETRIES=2
PAYPOOL_LLM_RETRY_BACKOFF_MS=500

# demo simulates money; paypal_sandbox calls the real sandbox API.
PAYPOOL_PAYMENT_PROVIDER=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SELLER_ID=seller-demo
PAYPAL_LOGIN_ENABLED=false
PAYPAL_LOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/paypal/callback
